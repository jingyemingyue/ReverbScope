# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
*.manifest
*.spec.bak

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Local configuration and secrets (never commit) ---
.env
.env.*
*.local
*.local.*
config.local.*
secrets.*
*.pem
*.key
*.p12
*.token
credentials*
.reverbscope/
reverbscope.local.toml

# --- Measurement data (raw audio is user data, not source) ---
*.wav
*.aif
*.aiff
*.flac
*.npz
*.npy
sessions/
measurements/
recordings/
!tests/fixtures/**/*.wav

# --- Temporary / scratch files ---
tmp/
temp/
scratch/
*.tmp
*.log
*.orig
*.rej
*.bak
.cache/

# --- gettext (compiled at packaging time; do not commit) ---
*.mo

# --- Generated documentation site (S7) ---
site/

# --- Packaging outputs ---
*.dmg
*.app/
*.exe
*.msi
*.AppImage
