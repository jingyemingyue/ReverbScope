{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReverbScope comparison.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparable",
    "common_band",
    "notes",
    "decay"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "reverbscope_version": { "type": "string" },
    "comparable": { "type": "boolean" },
    "common_band": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "decay": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "frequency_response": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/frequency_response_delta" }]
    },
    "reflections": { "type": "array", "items": { "type": "object" } },
    "noise": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "resonances": { "type": "array", "items": { "type": "object" } },
    "placement": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "loopback": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "baseline_created_at": { "type": "string" },
    "candidate_created_at": { "type": "string" },
    "baseline_session": { "type": ["string", "null"] },
    "candidate_session": { "type": ["string", "null"] },
    "settings": { "type": "object" }
  },
  "$defs": {
    "validity": {
      "type": "string",
      "enum": [
        "valid",
        "insufficient_decay_range",
        "unreliable",
        "not_computed",
        "outside_excitation_range",
        "not_comparable"
      ]
    },
    "metric_delta": {
      "type": "object",
      "required": ["name", "validity"],
      "properties": {
        "name": { "type": "string" },
        "baseline": { "type": ["number", "null"] },
        "candidate": { "type": ["number", "null"] },
        "delta_s": { "type": ["number", "null"] },
        "delta_percent": { "type": ["number", "null"] },
        "delta": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "validity": { "$ref": "#/$defs/validity" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "frequency_response_delta": {
      "type": "object",
      "properties": {
        "frequencies_hz": { "type": "array", "items": { "type": "number" } },
        "difference_db": { "type": "array", "items": { "type": "number" } },
        "band_mad_db": { "type": "array" },
        "smoothing_fraction": { "type": "integer" },
        "reference": { "type": "string" }
      }
    }
  }
}
