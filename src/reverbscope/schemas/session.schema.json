{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReverbScope session.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "created_at", "mode"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "session_id": { "type": "string" },
    "created_at": { "type": "string" },
    "mode": { "type": "string" },
    "room_name": { "type": "string" },
    "measurement_position": { "type": "string" },
    "microphone_name": { "type": "string" },
    "microphone_type": { "type": "string" },
    "microphone_calibration": { "type": "string" },
    "audio_interface": { "type": "string" },
    "input_channel": { "type": ["integer", "null"] },
    "output_channel": { "type": ["integer", "null"] },
    "loudspeaker": { "type": "string" },
    "sample_rate": { "type": ["integer", "null"] },
    "bit_depth": { "type": ["string", "null"] },
    "sweep_settings": { "type": "object" },
    "analysis_settings": { "type": "object" },
    "sweep_path": { "type": ["string", "null"] },
    "recording_path": { "type": ["string", "null"] },
    "impulse_response_path": { "type": ["string", "null"] },
    "result_path": { "type": ["string", "null"] },
    "analysis_summary": { "type": "object" },
    "notes": { "type": "string" },
    "recording_profile": { "type": "string" },
    "reverbscope_version": { "type": "string" },
    "platform": { "type": "string" },
    "loopback_channel": { "type": ["integer", "null"] }
  }
}
