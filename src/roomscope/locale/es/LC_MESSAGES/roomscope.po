msgstr "el flujo de audio terminó tras {done} de {total} tramas"

msgctxt "diagnostic"
msgid ""
"the audio device reported {count} buffer problem(s) during the take ({fl"
"ags}); the recording may contain dropouts"
msgstr ""
"el dispositivo de audio informó {count} problema(s) de búfer durante la "
"toma ({flags}); la grabación puede contener cortes"

msgid ""
"the audio backend (sounddevice / PortAudio) is not available; Standalone"
" Mode needs it, Universal DAW Mode does not"
msgstr ""
"el backend de audio (sounddevice / PortAudio) no está disponible; el mod"
"o independiente lo necesita, el modo DAW universal no"

