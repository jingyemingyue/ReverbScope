msgstr "repli 10 / 100 ms lorsque la latence du périphérique est illisible"

msgctxt "diagnostic"
msgid ""
"compiled default (512-128)/fs / (2048-512)/fs: 8 / 32 ms at 48 kHz if ha"
"rdware allows"
msgstr ""
"défaut compilé (512-128)/fs / (2048-512)/fs : 8 / 32 ms à 48 kHz si le m"
"atériel le permet"

msgctxt "diagnostic"
msgid "port latency divided by the JACK server rate"
msgstr "latence du port divisée par la fréquence du serveur JACK"

msgctxt "diagnostic"
msgid "not assessed"
msgstr "non évalué"

