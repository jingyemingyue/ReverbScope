msgstr "tampon préféré / maximal du pilote"

msgctxt "diagnostic"
msgid "PortAudio compiled defaults 120 / 240 ms"
msgstr "défauts compilés PortAudio 120 / 240 ms"

msgctxt "diagnostic"
msgid "PortAudio compiled defaults 90 / 180 ms"
msgstr "défauts compilés PortAudio 90 / 180 ms"

msgctxt "diagnostic"
