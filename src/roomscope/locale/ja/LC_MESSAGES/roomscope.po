msgstr "概要"

msgid "Impulse Response"
msgstr "インパルス応答"

msgid "Frequency Response"
msgstr "周波数特性"

msgid "Decay"
msgstr "減衰"

msgid "Noise"
msgstr "ノイズ"

msgid "Early Reflections"
msgstr "初期反射"

msgid "Placement"
msgstr "配置"

msgid "Figure"
msgstr "図"

msgid "Value"
msgstr "値"

msgid "Validity"
msgstr "妥当性"

msgid "Note"
msgstr "注記"

