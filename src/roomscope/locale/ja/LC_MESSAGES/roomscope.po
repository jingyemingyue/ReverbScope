msgid "each input channel may be listed once"
msgstr "各入力チャンネルは 1 回だけ列挙できます"

msgid "the loopback channel is 1-based and must be >= 1"
msgstr "ループバックチャンネルは 1 始まりで、1 以上である必要があります"

msgid ""
"input {channel} cannot be both the microphone and the loopback; record t"
"he loopback on a different input"
msgstr "入力 {channel} をマイクとループバックの両方にはできません。ループバックは別の入力に録ってください"

msgid "playback level must be <= 0 dBFS"
msgstr "再生レベルは 0 dBFS 以下である必要があります"

msgid "signal is silent"
msgstr "信号が無音です"

msgid "latency must be 'low' or 'high'"
msgstr "レイテンシは 'low' または 'high' である必要があります"

msgid "unknown audio backend {name}; available: portaudio, fake"
msgstr "不明なオーディオバックエンド {name}。利用可能: portaudio, fake"

msgid "sample rate {rate} Hz is not in {supported}"
msgstr "サンプルレート {rate} Hz は {supported} にありません"

msgid "kind must be 'input' or 'output'"
msgstr "kind は 'input' または 'output' である必要があります"

msgid "fake backend has no device {device}"
msgstr "fake バックエンドにデバイス {device} はありません"

msgid "fake backend only has device 0"
msgstr "fake バックエンドのデバイスは 0 だけです"

msgid "channels are 1-based and must be >= 1"
msgstr "チャンネルは 1 始まりで、1 以上である必要があります"

msgid "measurement stopped"
msgstr "測定を停止しました"

msgid "playback/recording timed out"
msgstr "再生 / 録音がタイムアウトしました"

msgid "playback/recording failed: {error}"
msgstr "再生 / 録音に失敗しました: {error}"

msgid "playback/recording failed in the audio callback: {error}"
msgstr "オーディオコールバックで再生 / 録音に失敗しました: {error}"

msgid "the audio stream ended after {done} of {total} frames"
msgstr "オーディオストリームは {total} フレーム中 {done} で終わりました"

msgctxt "diagnostic"
msgid ""
"the audio device reported {count} buffer problem(s) during the take ({fl"
"ags}); the recording may contain dropouts"
msgstr "テイク中にオーディオデバイスがバッファ問題を {count} 件報告しました（{flags}）。録音にドロップアウトがある可能性があります"

msgid ""
"the audio backend (sounddevice / PortAudio) is not available; Standalone"
" Mode needs it, Universal DAW Mode does not"
msgstr ""
"オーディオバックエンド（sounddevice / PortAudio）がありません。スタンドアロンモードには必要です。ユニバーサル DAW モ"
"ードには不要です"

msgid "cannot query audio devices: {error}"
msgstr "オーディオデバイスを照会できません: {error}"

msgid "input device {device} does not support {rate} Hz: {error}"
msgstr "入力デバイス {device} は {rate} Hz をサポートしません: {error}"

msgid "output device {device} does not support {rate} Hz: {error}"
msgstr "出力デバイス {device} は {rate} Hz をサポートしません: {error}"

msgctxt "diagnostic"
msgid ""
"WASAPI: shared mode goes through the Windows audio engine and accepts on"
"ly the device's Default Format rate; exclusive mode (--wasapi-exclusive)"
" bypasses the engine at a rate the hardware supports"
msgstr ""
"WASAPI: 共有モードは Windows オーディオエンジンを通り、デバイスの Default Format レートだけを受けます。排他モー"
"ド（--wasapi-exclusive）はハードウェアが支えるレートでエンジンを迂回します"

msgctxt "diagnostic"
msgid ""
"WDM kernel streaming: bypasses the Windows mixer; the device must suppor"
"t the rate"
msgstr "WDM カーネルストリーミング: Windows ミキサーを迂回します。デバイスがそのレートを支える必要があります"

msgctxt "diagnostic"
msgid "ASIO: direct driver path (not included in RoomScope's desktop bundles)"
msgstr "ASIO: 直接ドライバ経路（RoomScope のデスクトップバンドルには含まれません）"

msgctxt "diagnostic"
msgid ""
"DirectSound: deprecated, runs on the Windows audio engine; resamples and"
" mixes, and PortAudio does not check its rates (all look accepted); pref"
"er WASAPI"
msgstr ""
"DirectSound: 非推奨。Windows オーディオエンジン上でリサンプルとミックスをします。PortAudio はそのレートを検査せず"
"、すべて受けたように見えます。WASAPI を使ってください"

msgctxt "diagnostic"
msgid ""
"MME: legacy path through the Windows audio engine; resamples and mixes, "
"truncates device names; prefer WASAPI"
msgstr ""
"MME: Windows オーディオエンジン経由のレガシー経路。リサンプルとミックスをし、デバイス名を切り詰めます。WASAPI を使ってくださ"
"い"

msgctxt "diagnostic"
msgid ""
"Core Audio: the device runs at its nominal rate (Audio MIDI Setup) and P"
"ortAudio converts other rates, unless --coreaudio-set-rate sets the devi"
"ce rate and refuses to convert"
msgstr ""
"Core Audio: デバイスは公称レート（Audio MIDI Setup）で動き、PortAudio が他レートを変換します。--core"
"audio-set-rate ならデバイスレートを設定し、変換を拒否します"

msgctxt "diagnostic"
msgid ""
"ALSA: a hw: device is direct; default, pulse, pipewire, dmix and plug de"
"vices may resample"
msgstr "ALSA: hw: デバイスは直接です。default、pulse、pipewire、dmix、plug はリサンプルすることがあります"

msgctxt "diagnostic"
msgid "JACK: runs at the JACK server's rate only"
msgstr "JACK: JACK サーバーのレートだけで動きます"

msgctxt "diagnostic"
msgid "OSS: legacy Linux interface"
msgstr "OSS: Linux のレガシーインターフェース"

msgctxt "diagnostic"
msgid "synthetic backend: nothing is played"
msgstr "合成バックエンド: 再生しません"

msgctxt "diagnostic"
msgid ""
"shared-mode engine buffer default 10 ms; exclusive uses the device perio"
"d"
msgstr "共有モードのエンジンバッファ既定は 10 ms。排他はデバイス周期を使います"

msgctxt "diagnostic"
msgid "WaveRT compiled defaults 10 / 40 ms (WaveCyclic 10 / 85 ms)"
msgstr "WaveRT のコンパイル時既定 10 / 40 ms（WaveCyclic は 10 / 85 ms）"

msgctxt "diagnostic"
msgid "preferred / maximum driver buffer"
msgstr "ドライバの推奨 / 最大バッファ"

msgctxt "diagnostic"
msgid "PortAudio compiled defaults 120 / 240 ms"
msgstr "PortAudio のコンパイル時既定 120 / 240 ms"

msgctxt "diagnostic"
msgid "PortAudio compiled defaults 90 / 180 ms"
msgstr "PortAudio のコンパイル時既定 90 / 180 ms"

msgctxt "diagnostic"
msgid "fallback 10 / 100 ms when the device latency is unreadable"
msgstr "デバイスレイテンシが読めないときのフォールバック 10 / 100 ms"

msgctxt "diagnostic"
msgid ""
"compiled default (512-128)/fs / (2048-512)/fs: 8 / 32 ms at 48 kHz if ha"
"rdware allows"
msgstr "コンパイル時既定 (512-128)/fs / (2048-512)/fs: ハードウェアが許せば 48 kHz で 8 / 32 ms"

msgctxt "diagnostic"
msgid "port latency divided by the JACK server rate"
msgstr "ポートレイテンシを JACK サーバーレートで割った値"

msgctxt "diagnostic"
msgid "not assessed"
msgstr "評価していません"

msgctxt "diagnostic"
msgid ""
"requested 4 fragments × 128 frames; low=(nfrags-1)*frag/fs (8 / 32 ms at"
" 48 kHz if the driver keeps those sizes)"
msgstr ""
"要求は 4 フラグメント × 128 フレーム。low=(nfrags-1)*frag/fs（ドライバがそのサイズを保てば 48 kHz で 8"
" / 32 ms）"

msgctxt "diagnostic"
msgid "PortAudio host-API name on a given OS"
msgstr "ある OS 上の PortAudio ホスト API 名"

msgctxt "diagnostic"
msgid "measured round-trip latency"
msgstr "測った往復レイテンシ"

msgctxt "diagnostic"
msgid "whether Windows/Core Audio expose loopback as extra channels"
msgstr "Windows / Core Audio がループバックを追加チャンネルとして出すか"

msgctxt "diagnostic"
msgid "analogue line-output count"
msgstr "アナログライン出力の数"

msgctxt "diagnostic"
msgid "PortAudio channel count including ADAT at each rate"
msgstr "各レートでの PortAudio チャンネル数（ADAT を含む）"

msgctxt "diagnostic"
msgid "discrete sample-rate list (only a 28–200 kHz range is stated)"
msgstr "離散サンプルレート一覧（28–200 kHz の範囲だけが述べられています）"

msgctxt "diagnostic"
msgid ""
"This machine's PortAudio device list (ALSA 0 devices, OSS 0 devices): no"
" physical interface"
msgstr "このマシンの PortAudio デバイス一覧（ALSA 0 台、OSS 0 台）: 物理インターフェースなし"

msgctxt "diagnostic"
msgid "Measured full-duplex round-trip latency on any interface"
msgstr "任意のインターフェースで測った全二重往復レイテンシ"

msgctxt "diagnostic"
msgid ""
"Pa_IsFormatSupported results on a physical interface (sample-rate negoti"
"ation)"
msgstr "物理インターフェース上の Pa_IsFormatSupported 結果（サンプルレート交渉）"

msgctxt "diagnostic"
msgid ""
"ASIO compiled numeric default latency (PortAudio stores the driver's buf"
"fer only)"
msgstr "ASIO のコンパイル時数値既定レイテンシ（PortAudio はドライババッファだけを保持）"

msgctxt "diagnostic"
msgid ""
"JACK compiled numeric default latency (only jack_port_get_latency / serv"
"er rate)"
msgstr "JACK のコンパイル時数値既定レイテンシ（jack_port_get_latency / サーバーレートのみ）"

msgctxt "diagnostic"
msgid ""
"Core Audio device-specific latency (only the 10 / 100 ms fallback is sou"
"rced)"
msgstr "Core Audio のデバイス固有レイテンシ（根拠があるのは 10 / 100 ms フォールバックのみ）"

msgctxt "diagnostic"
msgid ""
"Scarlett 18i20 4th Gen analogue line-output count (spec page did not yie"
"ld a clear figure)"
msgstr "Scarlett 18i20 4th Gen のアナログライン出力数（仕様ページから明確な数字は取れませんでした）"

msgctxt "diagnostic"
msgid ""
"USB Audio Class 1.0 / 2.0 discrete rate tables (USB-IF PDFs were not re-"
"read)"
msgstr "USB Audio Class 1.0 / 2.0 の離散レート表（USB-IF PDF は再読していません）"

msgctxt "diagnostic"
msgid ""
"Hardware bit depth of a PortAudio stream (RoomScope writes 32-bit float;"
" manufacturer pages above state 24-bit converters)"
msgstr ""
"PortAudio ストリームのハードウェアビット深度（RoomScope は 32-bit float で書きます。上記メーカーページは 24"
"-bit 変換器と述べます）"

msgctxt "diagnostic"
msgid "ALSA plugin or sound-server device: may resample and mix"
msgstr "ALSA プラグインまたはサウンドサーバーデバイス: リサンプルとミックスをする可能性があります"

msgctxt "diagnostic"
msgid "accepts none of RoomScope's sample rates for recording"
msgstr "録音向けに RoomScope のサンプルレートをどれも受けません"

msgctxt "diagnostic"
msgid "accepts none of RoomScope's sample rates for playback"
msgstr "再生向けに RoomScope のサンプルレートをどれも受けません"

msgctxt "diagnostic"
msgid "no audio device found; Universal DAW Mode still works"
msgstr "オーディオデバイスが見つかりません。ユニバーサル DAW モードは使えます"

msgid ""
"playback ({output}) and recording ({input}) use different devices, which"
" run on separate sample clocks; their drift smears the measurement. Use "
"one interface for both, or an aggregate device with drift correction (ma"
"cOS), and check the result with a loopback"
msgstr ""
"再生（{output}）と録音（{input}）が別デバイスで、別々のサンプルクロックです。ドリフトが測定をにじませます。両方に 1 つのインタ"
"ーフェースを使うか、ドリフト補正付きのアグリゲートデバイス（macOS）を使い、ループバックで結果を確認してください"

msgid ""
"input channel {channel} does not exist on {device} ({count} input channe"
"l(s))"
msgstr "入力チャンネル {channel} は {device} にありません（入力 {count} チャンネル）"

msgid ""
"output channel {channel} does not exist on {device} ({count} output chan"
"nel(s))"
msgstr "出力チャンネル {channel} は {device} にありません（出力 {count} チャンネル）"

msgid "there is no audio device {index}"
msgstr "オーディオデバイス {index} はありません"

msgid ""
"input {input} ({input_api}) and output {output} ({output_api}) belong to"
" different host APIs; PortAudio records and plays in one stream only wit"
"hin one host API. Choose both on the same host API"
msgstr ""
"入力 {input}（{input_api}）と出力 {output}（{output_api}）は別のホスト API です。PortAudio"
" は 1 つのホスト API 内でしか同時に録再できません。両方を同じホスト API で選んでください"

msgid ""
"{api} has no default input device; choose the input device on {api} as w"
"ell"
msgstr "{api} に既定の入力デバイスがありません。{api} 側でも入力デバイスを選んでください"

msgid ""
"{api} has no default output device; choose the output device on {api} as"
" well"
msgstr "{api} に既定の出力デバイスがありません。{api} 側でも出力デバイスを選んでください"

msgid ""
"WASAPI exclusive mode was requested, but {device} is a {api} device; cho"
"ose a Windows WASAPI device or drop --wasapi-exclusive"
msgstr ""
"WASAPI 排他モードが要求されましたが、{device} は {api} デバイスです。Windows WASAPI デバイスを選ぶか --"
"wasapi-exclusive を外してください"

msgid ""
"setting the Core Audio device rate was requested, but {device} is a {api"
"} device; drop --coreaudio-set-rate"
msgstr ""
"Core Audio のデバイスレート設定が要求されましたが、{device} は {api} デバイスです。--coreaudio-set-r"
"ate を外してください"

msgid "sample_rate must be positive"
msgstr "sample_rate は正である必要があります"

msgid "samples must be 1-D (mono) or 2-D (frames, channels)"
msgstr "samples は 1 次元（モノ）または 2 次元（フレーム, チャンネル）である必要があります"

msgid "signal is empty"
msgstr "信号が空です"

msgid "signal contains NaN or infinite samples"
msgstr "信号に NaN または無限大のサンプルがあります"

msgid "channel {index} does not exist (signal has {count} channel(s))"
msgstr "チャンネル {index} はありません（信号は {count} チャンネル）"

msgctxt "diagnostic"
msgid ""
"recording has {count} channels; channel {chosen} (highest RMS) was analy"
"sed. Use the channel setting to choose explicitly."
msgstr "録音は {count} チャンネルです。解析したのはチャンネル {chosen}（RMS が最大）です。チャンネル設定で明示してください。"

msgid "sample_rate must be a positive integer"
msgstr "sample_rate は正の整数である必要があります"

msgid "sample_rate {rate} is not supported; use one of {supported}"
msgstr "sample_rate {rate} は非対応です。{supported} のいずれかを使ってください"

msgid "duration_s must be >= 0.5 s"
msgstr "duration_s は 0.5 s 以上である必要があります"

msgid "duration_s must be <= 120 s"
msgstr "duration_s は 120 s 以下である必要があります"

msgid "start_hz must be > 0"
msgstr "start_hz は 0 より大きい必要があります"

msgid "end_hz must be greater than start_hz"
msgstr "end_hz は start_hz より大きい必要があります"

msgid "end_hz must not exceed the Nyquist frequency"
msgstr "end_hz はナイキスト周波数を超えてはいけません"

msgid "fades must be >= 0"
msgstr "フェードは 0 以上である必要があります"

msgid "fades must be shorter than the sweep"
msgstr "フェードはスイープより短い必要があります"

msgid "level_dbfs must be <= 0 dBFS"
msgstr "level_dbfs は 0 dBFS 以下である必要があります"

msgid "level_dbfs below -80 dBFS is not a usable test signal"
msgstr "-80 dBFS 未満の level_dbfs は使えるテスト信号ではありません"

msgid "silences must be >= 0"
msgstr "無音は 0 以上である必要があります"

msgid "channel must be >= 0 or None"
msgstr "channel は 0 以上または None である必要があります"

msgid "ir_pre_delay_ms must be >= 0"
msgstr "ir_pre_delay_ms は 0 以上である必要があります"

msgid "ir_max_length_s must be > 0.1 s"
msgstr "ir_max_length_s は 0.1 s より大きい必要があります"

msgid "at least one octave band is required"
msgstr "オクターブバンドが少なくとも 1 つ必要です"

msgid "octave band frequencies must be > 0"
msgstr "オクターブバンド周波数は 0 より大きい必要があります"

msgid "octave_bands_hz must be ascending"
msgstr "octave_bands_hz は昇順である必要があります"

msgid "fr_window_s must be > 0"
msgstr "fr_window_s は 0 より大きい必要があります"

msgid "fr_smoothing_fraction must be >= 0"
msgstr "fr_smoothing_fraction は 0 以上である必要があります"

msgid "noise_min_segment_s must be > 0"
msgstr "noise_min_segment_s は 0 より大きい必要があります"

msgid "reflection delay window is invalid"
msgstr "反射の遅延窓が無効です"

msgid "reflections_threshold_db must be negative"
msgstr "reflections_threshold_db は負である必要があります"

msgid "reflections_prominence_db must be > 0"
msgstr "reflections_prominence_db は 0 より大きい必要があります"

msgid "resonance_max_hz must be > 20 Hz"
msgstr "resonance_max_hz は 20 Hz より大きい必要があります"

msgid "resonance_min_prominence_db must be > 0"
msgstr "resonance_min_prominence_db は 0 より大きい必要があります"

msgid "decay_noise_margin_db must be >= 0"
msgstr "decay_noise_margin_db は 0 以上である必要があります"

msgid "placement_distance_m must be between 0.20 m and 15 m"
msgstr "placement_distance_m は 0.20 m から 15 m の間である必要があります"

msgid "placement_mic_height_m must be between 0.02 m and 5 m"
msgstr "placement_mic_height_m は 0.02 m から 5 m の間である必要があります"

msgid "placement_temperature_c must be between -20 C and 50 C"
msgstr "placement_temperature_c は -20 C から 50 C の間である必要があります"

msgid ""
"placement_mic_height_m needs placement_distance_m: a height on its own c"
"annot be turned into geometry"
msgstr "placement_mic_height_m には placement_distance_m が必要です。高さだけでは幾何になりません"

msgid "loopback_channel must be >= 0 or None"
msgstr "loopback_channel は 0 以上または None である必要があります"

