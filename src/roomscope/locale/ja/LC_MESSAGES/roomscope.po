msgid "measurement rates"
msgstr "測定レート"

msgid "Documented latency"
msgstr "文書化されたレイテンシ"

msgid ""
"Referenced manufacturer specs: roomscope devices --referenced (not a har"
"dware result)"
msgstr "参照したメーカー仕様: roomscope devices --referenced（ハードウェア結果ではありません）"

msgid "show manufacturer and repo specs (not a hardware result)"
msgstr "メーカーとリポジトリの仕様を表示（ハードウェア結果ではありません）"

msgid "Referenced device data (not measured)"
msgstr "参照デバイスデータ（未測定）"

msgid ""
"Public sources only. Not a RoomScope measurement and not a HARDWARE_TEST"
"S.md PASS."
msgstr "公開情報のみ。RoomScope の測定ではなく、HARDWARE_TESTS.md の PASS でもありません。"

msgid "Interface"
msgstr "インターフェース"

msgid "Bit depth"
msgstr "ビット深度"

msgid "Mixer default"
msgstr "ミキサー既定"

msgid "Channels"
msgstr "チャンネル"

msgid "Gaps with no citable source"
msgstr "引用できる出典がない欠落"

