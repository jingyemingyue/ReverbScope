"session.json names {name} at an absolute path ({path}); session files mu"
"st stay inside the session folder"
msgstr ""
"session.json が {name} を絶対パス（{path}）で指しています。セッションファイルはセッションフォルダー内に置く必要があり"
"ます"

msgid ""
"session.json names {name} outside the session folder ({path}); session f"
"iles must stay inside the session folder"
msgstr ""
"session.json が {name} をセッションフォルダーの外（{path}）で指しています。セッションファイルはセッションフォルダー内"
"に置く必要があります"

msgid "save_comparison expects a ComparisonResult"
msgstr "save_comparison は ComparisonResult を期待します"

msgid "comparison file not found: {path}"
msgstr "比較ファイルが見つかりません: {path}"

msgid "unknown exporter {name}; available: {available}"
msgstr "不明なエクスポーター {name}。利用可能: {available}"

msgid "the 'soundfile' package (libsndfile) is required for WAV I/O"
msgstr "WAV の入出力には 'soundfile' パッケージ（libsndfile）が必要です"

msgid "audio file not found: {path}"
msgstr "音声ファイルが見つかりません: {path}"

msgid "cannot read audio file {name}: {error}"
msgstr "音声ファイル {name} を読めません: {error}"

msgid "audio file is empty: {name}"
msgstr "音声ファイルが空です: {name}"

msgid "samples must be a non-empty 1-D or 2-D array"
msgstr "samples は空でない 1 次元または 2 次元配列である必要があります"

msgid "signal exceeds full scale; use subtype='FLOAT' or lower the level"
msgstr "信号がフルスケールを超えています。subtype='FLOAT' にするかレベルを下げてください"

msgid "cannot write audio file {path}: {error}"
msgstr "音声ファイル {path} を書けません: {error}"

msgid "{name} is larger than 1 MB; a sweep sidecar cannot be that large"
msgstr "{name} は 1 MB を超えています。スイープサイドカーはそれほど大きくできません"

msgid "cannot read sweep sidecar {name}: {error}"
msgstr "スイープサイドカー {name} を読めません: {error}"

msgid "{name} is not a RoomScope sweep sidecar"
msgstr "{name} は RoomScope のスイープサイドカーではありません"

msgid "{name} does not contain a sweep definition"
msgstr "{name} にスイープ定義がありません"

msgid ""
"Review before posting: device names can contain personal names; paths un"
"der your home folder are shown as ~."
msgstr "投稿前に確認してください。デバイス名に個人名が含まれることがあり、ホームフォルダー以下のパスは ~ と表示されます。"

