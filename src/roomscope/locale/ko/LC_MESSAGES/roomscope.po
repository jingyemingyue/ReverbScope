msgid "{kind} schema_version is not an integer"
msgstr "{kind} schema_version이 정수가 아닙니다"

msgid ""
"{kind} schema version {version} cannot be read by RoomScope {running}; t"
"his version reads schema {known} and below. Open the file in a newer Roo"
"mScope."
msgstr ""
"{kind} 스키마 버전 {version}을 RoomScope {running}이 읽을 수 없습니다. 이 버전은 스키마 {know"
"n} 이하를 읽습니다. 더 새 RoomScope에서 파일을 여세요."

msgid "{kind} must be a JSON object"
msgstr "{kind}는 JSON 객체여야 합니다"

msgid "invalid {kind} in file: {error}"
msgstr "파일의 {kind}가 잘못되었습니다: {error}"

msgid "expected a pair of numbers"
msgstr "숫자 쌍이 필요합니다"

msgid "unknown validity {value}"
msgstr "알 수 없는 유효성 {value}"

msgid "result.json is incomplete or invalid: {error}"
msgstr "result.json이 불완전하거나 잘못되었습니다: {error}"

msgid "settings data must be a JSON object"
msgstr "설정 데이터는 JSON 객체여야 합니다"

msgid "cannot read {path}: {error}"
msgstr "{path}을(를) 읽을 수 없습니다: {error}"

msgid "cannot write {path}: {error}"
msgstr "{path}을(를) 쓸 수 없습니다: {error}"

msgid ""
"{name} is {size} bytes; {kind} files larger than {limit} bytes are refus"
"ed"
msgstr "{name}은(는) {size}바이트입니다. {kind} 파일은 {limit}바이트를 넘으면 거절합니다"

msgid ""
"{name} nests {depth} levels; {kind} files deeper than {limit} are refuse"
"d"
msgstr "{name}은(는) {depth}단계 중첩입니다. {kind} 파일은 {limit}보다 깊으면 거절합니다"

msgid "{path} is not a JSON object"
msgstr "{path}은(는) JSON 객체가 아닙니다"

msgid ""
"write the bundle outside the session folder (it would be inside {folder}"
")"
msgstr "번들은 세션 폴더 밖에 쓰세요({folder} 안이 됩니다)"

msgid "cannot write bundle {path}: {error}"
msgstr "번들 {path}을(를) 쓸 수 없습니다: {error}"

msgid "cannot copy {source} to {target}: {error}"
msgstr "{source}을(를) {target}에 복사할 수 없습니다: {error}"

msgid "RT60 {seconds:.2f} s"
msgstr "RT60 {seconds:.2f} s"

msgid "RT60 n/a"
msgstr "RT60 n/a"

msgid "result.json not found next to {path}"
msgstr "{path} 옆에 result.json이 없습니다"

msgid ""
"impulse_response.wav not found next to {path} and result.json has no IR "
"samples"
msgstr "{path} 옆에 impulse_response.wav가 없고 result.json에도 IR 샘플이 없습니다"

msgid "not a directory: {path}"
msgstr "디렉터리가 아닙니다: {path}"

msgid "session file not found: {path}"
msgstr "세션 파일을 찾을 수 없습니다: {path}"

msgid ""
"session.json names {name} at an absolute path ({path}); session files mu"
"st stay inside the session folder"
msgstr "session.json이 {name}을(를) 절대 경로({path})로 가리킵니다. 세션 파일은 세션 폴더 안에 있어야 합니다"

msgid ""
"session.json names {name} outside the session folder ({path}); session f"
"iles must stay inside the session folder"
msgstr ""
"session.json이 {name}을(를) 세션 폴더 밖({path})으로 가리킵니다. 세션 파일은 세션 폴더 안에 있어야 합니"
"다"

msgid "save_comparison expects a ComparisonResult"
msgstr "save_comparison은 ComparisonResult를 기대합니다"

msgid "comparison file not found: {path}"
msgstr "비교 파일을 찾을 수 없습니다: {path}"

msgid "unknown exporter {name}; available: {available}"
msgstr "알 수 없는 내보내기 {name}. 사용 가능: {available}"

msgid "the 'soundfile' package (libsndfile) is required for WAV I/O"
msgstr "WAV 입출력에는 'soundfile' 패키지(libsndfile)가 필요합니다"

msgid "audio file not found: {path}"
msgstr "오디오 파일을 찾을 수 없습니다: {path}"

msgid "cannot read audio file {name}: {error}"
msgstr "오디오 파일 {name}을(를) 읽을 수 없습니다: {error}"

msgid "audio file is empty: {name}"
msgstr "오디오 파일이 비어 있습니다: {name}"

msgid "samples must be a non-empty 1-D or 2-D array"
msgstr "samples는 비어 있지 않은 1차원 또는 2차원 배열이어야 합니다"

msgid "signal exceeds full scale; use subtype='FLOAT' or lower the level"
msgstr "신호가 풀스케일을 넘습니다. subtype='FLOAT'를 쓰거나 레벨을 낮추세요"

msgid "cannot write audio file {path}: {error}"
msgstr "오디오 파일 {path}을(를) 쓸 수 없습니다: {error}"

msgid "{name} is larger than 1 MB; a sweep sidecar cannot be that large"
msgstr "{name}이(가) 1 MB보다 큽니다. 스윕 사이드카는 그렇게 클 수 없습니다"

msgid "cannot read sweep sidecar {name}: {error}"
msgstr "스윕 사이드카 {name}을(를) 읽을 수 없습니다: {error}"

msgid "{name} is not a RoomScope sweep sidecar"
msgstr "{name}은(는) RoomScope 스윕 사이드카가 아닙니다"

msgid "{name} does not contain a sweep definition"
msgstr "{name}에 스윕 정의가 없습니다"

msgid ""
"Review before posting: device names can contain personal names; paths un"
"der your home folder are shown as ~."
msgstr "올리기 전에 검토하세요. 장치 이름에 사람 이름이 들어 있을 수 있고, 홈 폴더 아래 경로는 ~로 표시됩니다."

