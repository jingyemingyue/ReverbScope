msgstr "RoomScope {version}({edition} 에디션, 데스크톱 번들)"

msgid "Build: {commit}"
msgstr "빌드: {commit}"

msgid "Build: no commit recorded (source or pip install)"
msgstr "빌드: 커밋 없음(소스 또는 pip 설치)"

