msgid "WaveRT compiled defaults 10 / 40 ms (WaveCyclic 10 / 85 ms)"
msgstr "WaveRT 編譯預設值 10 / 40 ms（WaveCyclic 為 10 / 85 ms）"

msgctxt "diagnostic"
msgid "preferred / maximum driver buffer"
msgstr "首選 / 最大驅動緩衝"

