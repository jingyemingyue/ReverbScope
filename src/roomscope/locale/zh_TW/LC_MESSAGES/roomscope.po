msgstr ""
"請求 4 個片段 × 每片段 128 幀；低延遲=(nfrags-1)*frag/fs（若驅動保持該大小，48 kHz 下為 8 / 32 ms"
"）"

msgctxt "diagnostic"
msgid "PortAudio host-API name on a given OS"
msgstr "給定操作系統上的 PortAudio 主機 API 名稱"

msgctxt "diagnostic"
msgid "measured round-trip latency"
msgstr "測得的往返延遲"

