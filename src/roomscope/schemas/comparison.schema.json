{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomScope comparison.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparable",
    "common_band",
    "notes",
    "decay"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "roomscope_version": { "type": "string" },
    "comparable": { "type": "boolean" },
    "common_band": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "decay": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "frequency_response": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/frequency_response_delta" }]
    },
    "reflections": { "type": "array", "items": { "$ref": "#/$defs/reflection_match" } },
    "noise": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "resonances": { "type": "array", "items": { "$ref": "#/$defs/resonance_match" } },
    "placement": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "loopback": { "type": "array", "items": { "$ref": "#/$defs/metric_delta" } },
    "baseline_created_at": { "type": "string" },
    "candidate_created_at": { "type": "string" },
    "baseline_session": { "type": ["string", "null"] },
    "candidate_session": { "type": ["string", "null"] },
    "settings": { "type": "object" }
  },
  "$defs": {
    "validity": {
      "type": "string",
      "enum": [
        "valid",
        "insufficient_decay_range",
        "unreliable",
        "not_computed",
        "outside_excitation_range",
        "not_comparable"
      ]
    },
    "metric_delta": {
      "type": "object",
      "required": ["name", "baseline", "candidate", "validity"],
      "properties": {
        "name": { "type": "string" },
        "baseline": { "type": ["number", "null"] },
        "candidate": { "type": ["number", "null"] },
        "delta_s": { "type": ["number", "null"] },
        "delta_percent": { "type": ["number", "null"] },
        "delta": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "validity": { "$ref": "#/$defs/validity" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "frequency_response_delta": {
      "type": "object",
      "properties": {
        "frequencies_hz": { "type": "array", "items": { "type": "number" } },
        "difference_db": { "type": "array", "items": { "type": "number" } },
        "band_mad_db": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "smoothing_fraction": { "type": "integer" },
        "reference": { "type": "string" }
      }
    },
    "reflection_match": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string" },
        "baseline_delay_ms": { "type": ["number", "null"] },
        "candidate_delay_ms": { "type": ["number", "null"] },
        "baseline_relative_db": { "type": ["number", "null"] },
        "candidate_relative_db": { "type": ["number", "null"] },
        "delay_delta_ms": { "type": ["number", "null"] },
        "level_delta_db": { "type": ["number", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["matched", "appeared"] } } },
          "then": { "$ref": "#/$defs/candidate_reflection" }
        },
        {
          "if": { "properties": { "status": { "const": "appeared" } } },
          "else": { "$ref": "#/$defs/baseline_reflection" }
        }
      ]
    },
    "baseline_reflection": {
      "required": ["baseline_delay_ms", "baseline_relative_db"],
      "properties": {
        "baseline_delay_ms": { "type": "number" },
        "baseline_relative_db": { "type": "number" }
      }
    },
    "candidate_reflection": {
      "required": ["candidate_delay_ms", "candidate_relative_db"],
      "properties": {
        "candidate_delay_ms": { "type": "number" },
        "candidate_relative_db": { "type": "number" }
      }
    },
    "resonance_match": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string" },
        "baseline_hz": { "type": ["number", "null"] },
        "candidate_hz": { "type": ["number", "null"] },
        "baseline_decay_distinguishable": { "type": ["boolean", "null"] },
        "candidate_decay_distinguishable": { "type": ["boolean", "null"] }
      }
    }
  }
}
