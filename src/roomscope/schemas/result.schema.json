{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomScope result.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "sample_rate",
    "sweep_settings",
    "analysis_settings",
    "impulse_response",
    "decay",
    "frequency_response",
    "noise",
    "reflections",
    "resonances",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "roomscope_version": { "type": "string" },
    "created_at": { "type": "string" },
    "sample_rate": { "$ref": "#/$defs/positive_count" },
    "sweep_settings": { "type": "object" },
    "analysis_settings": { "type": "object" },
    "impulse_response": { "$ref": "#/$defs/impulse_response" },
    "decay": { "$ref": "#/$defs/decay" },
    "frequency_response": { "$ref": "#/$defs/frequency_response" },
    "noise": { "$ref": "#/$defs/noise" },
    "reflections": { "$ref": "#/$defs/reflections" },
    "resonances": { "$ref": "#/$defs/resonances" },
    "clipping": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/clipping" }] },
    "placement": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/placement" }] },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "number_or_null": { "type": ["number", "null"] },
    "string_or_null": { "type": ["string", "null"] },
    "number_array": { "type": "array", "items": { "type": "number" } },
    "string_array": { "type": "array", "items": { "type": "string" } },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740992 },
    "positive_count": { "type": "integer", "minimum": 1, "maximum": 9007199254740992 },
    "pair": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "validity": {
      "type": "string",
      "enum": [
        "valid",
        "insufficient_decay_range",
        "unreliable",
        "not_computed",
        "outside_excitation_range",
        "not_comparable"
      ]
    },
    "decay_metric": {
      "type": "object",
      "required": ["name", "seconds", "validity", "evaluation_range_db"],
      "properties": {
        "name": { "type": "string" },
        "seconds": { "$ref": "#/$defs/number_or_null" },
        "validity": { "$ref": "#/$defs/validity" },
        "evaluation_range_db": { "$ref": "#/$defs/pair" },
        "nonlinearity_permille": { "$ref": "#/$defs/number_or_null" },
        "reason": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "energy_metric": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "$ref": "#/$defs/number_or_null" },
        "unit": { "type": "string" },
        "validity": { "$ref": "#/$defs/validity" },
        "reason": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "band_decay": {
      "type": "object",
      "properties": {
        "band_label": { "type": "string" },
        "center_hz": { "$ref": "#/$defs/number_or_null" },
        "mid_band_hz": { "$ref": "#/$defs/number_or_null" },
        "low_hz": { "$ref": "#/$defs/number_or_null" },
        "high_hz": { "$ref": "#/$defs/number_or_null" },
        "noise_floor_db": { "$ref": "#/$defs/number_or_null" },
        "peak_to_noise_db": { "$ref": "#/$defs/number_or_null" },
        "onset_time_s": { "$ref": "#/$defs/number_or_null" },
        "truncation_time_s": { "$ref": "#/$defs/number_or_null" },
        "edt": { "$ref": "#/$defs/decay_metric" },
        "t20": { "$ref": "#/$defs/decay_metric" },
        "t30": { "$ref": "#/$defs/decay_metric" },
        "rt60_estimate_s": { "$ref": "#/$defs/number_or_null" },
        "rt60_basis": { "$ref": "#/$defs/string_or_null" },
        "curvature_percent": { "$ref": "#/$defs/number_or_null" },
        "filter_bt_product": { "$ref": "#/$defs/number_or_null" },
        "filter_warning": { "$ref": "#/$defs/string_or_null" },
        "warnings": { "$ref": "#/$defs/string_array" },
        "c50": { "$ref": "#/$defs/energy_metric" },
        "c80": { "$ref": "#/$defs/energy_metric" },
        "d50": { "$ref": "#/$defs/energy_metric" },
        "centre_time": { "$ref": "#/$defs/energy_metric" },
        "edc_time_s": { "$ref": "#/$defs/number_array" },
        "edc_db": { "$ref": "#/$defs/number_array" }
      }
    },
    "excitation_band": {
      "type": "object",
      "required": ["low_hz", "high_hz", "source"],
      "properties": {
        "low_hz": { "type": "number" },
        "high_hz": { "type": "number" },
        "source": { "type": "string" },
        "note": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "impulse_response": {
      "type": "object",
      "required": [
        "sample_rate",
        "length_samples",
        "direct_sound_index",
        "pre_delay_samples",
        "peak_value",
        "valid_length_s",
        "direct_sound_confidence"
      ],
      "properties": {
        "sample_rate": { "$ref": "#/$defs/positive_count" },
        "length_samples": { "type": "integer" },
        "direct_sound_index": { "$ref": "#/$defs/count" },
        "direct_sound_time_s": { "type": "number" },
        "pre_delay_samples": { "$ref": "#/$defs/count" },
        "peak_value": { "type": "number" },
        "direct_level_dbfs": { "$ref": "#/$defs/number_or_null" },
        "valid_length_s": { "type": "number" },
        "pre_peak_margin_db": { "$ref": "#/$defs/number_or_null" },
        "direct_sound_confidence": { "type": "string" },
        "sweep_start_in_recording_s": { "type": "number" },
        "first_sweep_start_in_recording_s": { "$ref": "#/$defs/number_or_null" },
        "sweep_passes": { "$ref": "#/$defs/positive_count" },
        "excitation_band": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/excitation_band" }]
        },
        "harmonic_distortion": {
          "type": "array",
          "items": { "$ref": "#/$defs/harmonic_distortion" }
        },
        "aliased_distortion": {
          "type": "array",
          "items": { "$ref": "#/$defs/aliased_distortion" }
        },
        "loopback": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/loopback" }] },
        "playback_speed": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/playback_speed" }] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "samples": { "type": "array", "items": { "type": "number" } }
      }
    },
    "decay": {
      "type": "object",
      "required": ["method", "broadband", "bands"],
      "properties": {
        "method": { "type": "string" },
        "time_origin": { "type": "string" },
        "broadband": { "$ref": "#/$defs/band_decay" },
        "bands": { "type": "array", "items": { "$ref": "#/$defs/band_decay" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "frequency_response": {
      "type": "object",
      "required": ["smoothing_fraction", "window_s", "reference", "points"],
      "properties": {
        "smoothing_fraction": { "$ref": "#/$defs/count" },
        "window_s": { "type": "number" },
        "lead_in_s": { "type": "number" },
        "resolution_hz": { "type": "number" },
        "bin_spacing_hz": { "type": "number" },
        "gated": { "type": "boolean" },
        "excitation_band": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/excitation_band" }]
        },
        "reference": { "type": "string" },
        "points": { "type": "integer" },
        "frequencies_hz": { "type": "array", "items": { "type": "number" } },
        "magnitude_db_raw": { "type": "array", "items": { "type": "number" } },
        "magnitude_db_smoothed": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "number" } }
          ]
        }
      }
    },
    "noise": {
      "type": "object",
      "required": ["rms_dbfs", "calibration"],
      "properties": {
        "segment_source": { "$ref": "#/$defs/string_or_null" },
        "segment_start_s": { "$ref": "#/$defs/number_or_null" },
        "segment_duration_s": { "$ref": "#/$defs/number_or_null" },
        "rms_dbfs": { "$ref": "#/$defs/number_or_null" },
        "peak_dbfs": { "$ref": "#/$defs/number_or_null" },
        "band_levels_dbfs": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "$ref": "#/$defs/number_or_null" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "hum": { "type": "array", "items": { "$ref": "#/$defs/hum" } },
        "calibration": { "type": "string" },
        "psd_reference": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "psd_frequencies_hz": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "number" } }
          ]
        },
        "psd_db": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "number" } }
          ]
        }
      }
    },
    "reflections": {
      "type": "object",
      "required": ["reflections", "direct_sound_confidence"],
      "properties": {
        "direct_sound_time_s": { "type": "number" },
        "direct_sound_confidence": { "type": "string" },
        "window_ms": { "$ref": "#/$defs/pair" },
        "analysed_window_ms": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pair" }]
        },
        "window_truncated": { "type": "boolean" },
        "threshold_db": { "type": "number" },
        "reflections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["delay_ms", "relative_db"],
            "properties": {
              "delay_ms": { "type": "number" },
              "relative_db": { "type": "number" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resonances": {
      "type": "object",
      "required": ["max_frequency_hz", "candidates"],
      "properties": {
        "max_frequency_hz": { "type": "number" },
        "searched_range_hz": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pair" }]
        },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/resonance_candidate" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "playback_speed": {
      "type": "object",
      "required": ["speed_ratio", "kind", "generated_rate_hz"],
      "properties": {
        "speed_ratio": { "type": "number" },
        "kind": { "enum": ["sample_rate_mismatch", "time_stretch"] },
        "generated_rate_hz": { "$ref": "#/$defs/positive_count" },
        "played_rate_hz": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/positive_count" }] }
      }
    },
    "clipping": {
      "type": "object",
      "required": ["peak_dbfs", "runs", "samples", "clipped"],
      "properties": {
        "peak_dbfs": { "type": "number" },
        "runs": { "$ref": "#/$defs/count" },
        "samples": { "$ref": "#/$defs/count" },
        "clipped": { "type": "boolean" },
        "quantisation_step": { "$ref": "#/$defs/number_or_null" }
      }
    },
    "harmonic_distortion": {
      "type": "object",
      "required": ["order", "offset_s"],
      "properties": {
        "order": { "$ref": "#/$defs/count" },
        "offset_s": { "type": "number" },
        "level_db": { "$ref": "#/$defs/number_or_null" },
        "floor_db": { "$ref": "#/$defs/number_or_null" },
        "band_hz": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pair" }] },
        "reason": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "aliased_distortion": {
      "type": "object",
      "required": ["order"],
      "properties": {
        "order": { "$ref": "#/$defs/count" },
        "band_hz": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pair" }] },
        "level_db": { "$ref": "#/$defs/number_or_null" },
        "floor_db": { "$ref": "#/$defs/number_or_null" },
        "significant": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "loopback": {
      "type": "object",
      "properties": {
        "channel": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/count" }] },
        "compensation_applied": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/string_or_null" },
        "latency_samples": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": -9007199254740992, "maximum": 9007199254740992 }
          ]
        },
        "path_delay_ms": { "$ref": "#/$defs/number_or_null" },
        "distance_upper_bound_m": { "$ref": "#/$defs/number_or_null" },
        "interface_response_hz": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/number_array" }]
        },
        "interface_response_db": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/number_array" }]
        },
        "notes": { "$ref": "#/$defs/string_array" }
      }
    },
    "hum": {
      "type": "object",
      "required": ["base_hz"],
      "properties": {
        "base_hz": { "type": "number" },
        "harmonics": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "distinct_harmonics_hz": { "$ref": "#/$defs/number_array" },
        "strongest_prominence_db": { "$ref": "#/$defs/number_or_null" },
        "detected": { "type": "boolean" },
        "note": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "resonance_candidate": {
      "type": "object",
      "required": ["frequency_hz", "level_above_baseline_db"],
      "properties": {
        "frequency_hz": { "type": "number" },
        "level_above_baseline_db": { "type": "number" },
        "narrowband_decay_20db_s": { "$ref": "#/$defs/number_or_null" },
        "filter_ringing_20db_s": { "$ref": "#/$defs/number_or_null" },
        "surroundings_decay_20db_s": { "$ref": "#/$defs/number_or_null" },
        "decay_distinguishable": { "type": "boolean" }
      }
    },
    "placement_length": {
      "type": "object",
      "properties": {
        "metres": { "$ref": "#/$defs/number_or_null" },
        "validity": { "$ref": "#/$defs/validity" },
        "reason": { "$ref": "#/$defs/string_or_null" },
        "input_uncertainty_m": { "$ref": "#/$defs/number_or_null" },
        "uncertainty_excludes": { "$ref": "#/$defs/string_or_null" },
        "alternatives_m": { "$ref": "#/$defs/number_array" },
        "missing_input": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "boundary_candidate": {
      "type": "object",
      "required": ["delay_ms", "relative_db", "excess_path_m"],
      "properties": {
        "delay_ms": { "type": "number" },
        "relative_db": { "type": "number" },
        "excess_path_m": { "type": "number" },
        "mirror_path_m": { "$ref": "#/$defs/number_or_null" },
        "product_m2": { "$ref": "#/$defs/number_or_null" },
        "geometric_mean_m": { "$ref": "#/$defs/number_or_null" },
        "mean_distance_bracket_m": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pair" }]
        },
        "specular_ceiling_db": { "$ref": "#/$defs/number_or_null" },
        "surface": { "$ref": "#/$defs/string_or_null" },
        "interpretable_as_plane": { "type": ["boolean", "null"] },
        "excluded_reason": { "$ref": "#/$defs/string_or_null" }
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "tier": { "$ref": "#/$defs/count" },
        "distance_m": { "$ref": "#/$defs/number_or_null" },
        "mic_height_m": { "$ref": "#/$defs/number_or_null" },
        "temperature_c": { "type": "number" },
        "temperature_assumed": { "type": "boolean" },
        "speed_of_sound_m_s": { "type": "number" },
        "speed_of_sound_reference": { "type": "string" },
        "source_height_m": { "$ref": "#/$defs/placement_length" },
        "ceiling_height_m": { "$ref": "#/$defs/placement_length" },
        "horizontal_separation_m": { "$ref": "#/$defs/placement_length" },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/boundary_candidate" } },
        "analysed_window_ms": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pair" }] },
        "window_truncated": { "type": "boolean" },
        "coordinates_withheld": { "type": "string" },
        "notes": { "$ref": "#/$defs/string_array" }
      }
    }
  }
}
